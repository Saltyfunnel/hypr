[general]
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1

[input]
method = pipewire
source = auto

[output]
method = noncurses
style = stereo

[color]
background = 'default'

# Enable dynamic gradient with formatted hex values
gradient = 1
gradient_count = 6
gradient_color_1 = '#{color1.strip}'
gradient_color_2 = '#{color2.strip}'
gradient_color_3 = '#{color3.strip}'
gradient_color_4 = '#{color4.strip}'
gradient_color_5 = '#{color5.strip}'
gradient_color_6 = '#{color6.strip}'

[smoothing]
integral = 77
monstercat = 1
waves = 0
gravity = 100
