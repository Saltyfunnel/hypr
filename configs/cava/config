# Cava Configuration for Arch / Hyprland (PipeWire & Terminal Colors)

[general]
# Higher framerate for smoother movement on high-refresh monitors
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1

[input]
# PipeWire natively handles PulseAudio stream hooks seamlessly
method = pipewire
source = auto

[output]
method = ncurses
style = stereo

[color]
# Set background to transparent so Kitty background/wallpapers show through
background = 'default'

# Use terminal foreground colors. Because pywal16 dynamically updates
# Kitty's color sequences, Cava matches your pywal theme automatically
# without needing a dynamic config rewrite or symlink.
foreground = 'default'

[smoothing]
integral = 77
monstercat = 1
waves = 0
gravity = 100
